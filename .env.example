# ─────────────────────────────────────────────────────────────────────────────
# FX Compass Pro — environment variables
#
# Copy to `.env` and fill in. `.env` is git-ignored.
#
#   ⚠  NEVER prefix a secret with VITE_.
#      Vite inlines every VITE_* variable into the browser bundle. A key named
#      VITE_TWELVEDATA_API_KEY would be publicly readable by anyone who opens
#      devtools. The build fails if a VITE_*KEY / VITE_*SECRET / VITE_*TOKEN
#      variable is detected.
#
#   Variables below are read server-side only, via process.env inside modules
#   that are dynamically imported within server functions. They are never
#   serialised to the client.
# ─────────────────────────────────────────────────────────────────────────────


# ── Market data ──────────────────────────────────────────────────────────────

# Twelve Data API key. Free tier: https://twelvedata.com/pricing
# Without this the app shows an explicit "no verified data" state rather than
# inventing prices.
TWELVEDATA_API_KEY=

# Free-tier rate limits. The built-in token bucket spaces requests to stay
# inside these. Raise only if your plan actually allows it.
TWELVEDATA_CREDITS_PER_MIN=8
TWELVEDATA_CREDITS_PER_DAY=800

# Enable the Twelve Data WebSocket feed for live quotes.
# The free tier does not include WebSocket access; leave false unless your
# plan supports it. REST polling is used either way.
TWELVEDATA_WEBSOCKET_ENABLED=false


# ── Time ─────────────────────────────────────────────────────────────────────

# Your broker's MT4/MT5 server timezone. HF Markets and most MT brokers run
# EET/EEST (UTC+2 winter, UTC+3 summer), which puts the daily candle close at
# 17:00 New York. Candle buckets are aligned to this so the app's D1/W1/H4
# candles match the ones in your terminal.
BROKER_SERVER_TIMEZONE=Europe/Athens

# Timezone used for displaying times to you. Africa/Lagos is UTC+1, no DST.
DISPLAY_TIMEZONE=Africa/Lagos


# ── Database ─────────────────────────────────────────────────────────────────

# Local SQLite file for development. In production on Cloudflare, a D1 binding
# is used instead and this value is ignored.
DATABASE_URL=file:./data/fxcompass.db


# ── News / economic calendar ─────────────────────────────────────────────────

# Enable the free economic-calendar feed. When disabled, unreachable, or
# returning unusable data, the app shows
#   "NEWS CHECK UNAVAILABLE — VERIFY ECONOMIC CALENDAR MANUALLY"
# It never assumes that no news exists.
NEWS_CALENDAR_ENABLED=true

# Minutes before and after a high-impact event during which new signals are
# blocked or warned about.
NEWS_BUFFER_BEFORE_MINUTES=30
NEWS_BUFFER_AFTER_MINUTES=15


# ── Public API (agent / MCP integration) ─────────────────────────────────────

# /api/public/feed and /api/public/events are DISABLED unless this token is set.
# When set, callers must send:  Authorization: Bearer <token>
# Leave empty to keep both endpoints off. Generate with:
#   openssl rand -hex 32
PUBLIC_API_TOKEN=

# Comma-separated allowed origins for the public API. "*" is refused when a
# token is set. Leave empty to allow same-origin only.
PUBLIC_API_ALLOWED_ORIGINS=


# ── Development only ─────────────────────────────────────────────────────────

# Allow clearly-labelled synthetic sample candles so the interface can be
# reviewed without an API key. Ignored when NODE_ENV=production. Sample data
# can never produce a trade permission.
ALLOW_DEMO_DATA=false
